---
import BaseLayout from '../layouts/BaseLayout.astro';
import ancestorsData from '../data/ancestors.json';
import placesData from '../data/places.json';
import { branchDefs } from '../lib/branches';

type LifeEvent = {
  year: number;
  date?: string;
  between?: [number, number];
  circa?: boolean;
  place: string;
  kind: string;
  certainty?: string;
  source?: string;
  note?: string;
};

type AncestorRecord = {
  id: string;
  slug: string;
  name: string;
  surname: string;
  birth: string;
  death: string;
  generation: number;
  branch: string;
  life: LifeEvent[];
  life_source: 'life' | 'birth-death';
};

type PlaceRecord = { lat: number | null; lon: number | null };

const ancestors = ancestorsData as AncestorRecord[];
const places = placesData as Record<string, PlaceRecord>;

// One color per branch (the four grandparent lines), not per surname.
const branchColor: Record<string, string> = {
  home: '#3d2e1e',
  krumpos: '#7a3b2e',
  coppersmith: '#2e5d3a',
  martin: '#4a5d7e',
  schmidt: '#a06b2e',
};
const branchLabel: Record<string, string> = {
  home: 'Parents',
  ...Object.fromEntries(Object.entries(branchDefs).map(([k, b]) => [k, b.title.replace(' Branch', '')])),
};

function yearOf(s: string): number | null {
  const m = String(s || '').match(/(\d{4})/);
  return m ? Number(m[1]) : null;
}

const people = ancestors
  .map((a) => {
    const events = a.life.map((ev) => {
      const p = places[ev.place];
      const ok = p && p.lat != null && p.lon != null;
      return { ...ev, lat: ok ? p.lat : null, lon: ok ? p.lon : null };
    });
    const born = events.find((e) => e.kind === 'born');
    const died = events.find((e) => e.kind === 'died');
    return {
      id: a.id,
      slug: a.slug,
      name: a.name,
      branch: a.branch,
      generation: a.generation,
      traced: a.life_source === 'life',
      birthYear: born?.year ?? yearOf(a.birth),
      deathYear: died?.year ?? yearOf(a.death),
      events,
    };
  })
  .filter((p) => p.events.some((e) => e.lat != null));

const allYears = people.flatMap((p) => p.events.map((e) => e.year));
const timeMin = Math.floor(Math.min(...allYears) / 10) * 10;
const timeMaxEvent = Math.max(...allYears);
const tracedCount = people.filter((p) => p.traced).length;
const branchesShown = Object.keys(branchColor).filter((b) => people.some((p) => p.branch === b));
---

<BaseLayout
  title="Family Map"
  description="Scrub through time and watch the direct ancestors born, crossing, settling, and moving across Europe and North America."
>
  <h1 class="font-serif text-3xl text-[var(--color-dark-brown)] mb-2">Where they lived</h1>
  <p class="text-sm text-[var(--color-warm-gray)] mb-5">
    Drag through the years and the map shows the direct line as it stood: who was alive, where,
    and where they went next. {people.length} ancestors are on the map. {tracedCount} have their
    whole lives traced so far, with census homes, crossings, and moves. The rest show only where they
    were born and died. More gets added as the records turn up.
  </p>

  <div id="lm-stage" class="lm-stage">
    <div class="lifemap-controls lm-controls mb-3">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span id="lm-year" class="font-serif text-4xl tabular-nums text-[var(--color-dark-brown)]">All years</span>
        <span id="lm-status" class="text-sm text-[var(--color-warm-gray)]" aria-live="polite"></span>
      </div>
      <div class="flex items-center gap-3 mt-2">
        <button
          id="lm-play"
          type="button"
          aria-pressed="false"
          class="lm-btn shrink-0"
          aria-label="Play through the years"
        >▶ Play</button>
        <span class="text-xs tabular-nums text-[var(--color-muted)]">{timeMin}</span>
        <input
          id="lm-slider"
          type="range"
          min={timeMin}
          max={timeMaxEvent + 1}
          step="1"
          value={timeMaxEvent + 1}
          aria-label="Show the family as of this year"
          class="flex-1 min-w-0 cursor-pointer"
          style="accent-color: var(--color-accent);"
        />
        <span class="text-xs text-[var(--color-muted)]">all</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 mt-2 text-sm">
        <button id="lm-tilt" type="button" aria-pressed="false" class="lm-btn">Tilt</button>
        <label class="lm-btn flex items-center gap-1.5 has-[:disabled]:opacity-40">
          <input id="lm-follow" type="checkbox" disabled style="accent-color: var(--color-accent);" />
          Follow selected
        </label>
        <button id="lm-fs" type="button" aria-pressed="false" class="lm-btn ml-auto">⤢ Fullscreen</button>
      </div>
    </div>

    <div class="lm-mapwrap relative">
      <div
        id="ancestor-map"
        class="w-full h-[70vh] min-h-[420px] max-h-[640px] rounded border border-[var(--color-parchment-dark)]"
      ></div>
      <button id="lm-skip" type="button" hidden class="lm-btn lm-skip">Skip ›</button>
    </div>

    <div class="lm-branches mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      {
        branchesShown.map((b) => (
          <button
            type="button"
            data-branch={b}
            aria-pressed="true"
            class="lm-branch flex items-center gap-2 hover:opacity-70"
          >
            <span class="inline-block w-3 h-3 rounded-full" style={`background-color: ${branchColor[b]}`}></span>
            <span>{branchLabel[b] ?? b}</span>
          </button>
        ))
      }
      <span class="ml-auto flex gap-2 text-xs">
        <button type="button" data-view="all" class="lm-view underline decoration-dotted">Whole map</button>
        <button type="button" data-view="bay" class="lm-view underline decoration-dotted">Green Bay</button>
      </span>
    </div>
    <p class="lm-legend text-xs text-[var(--color-muted)] mt-2">
      Dot = living that year · small square = resting place · dashed = probable, not yet proven ·
      dotted line = brought home for burial · ring = a winter home.
    </p>

    <section id="lm-person" class="mt-6 hidden" aria-live="polite"></section>
  </div>

  <style is:global>
    .lm-btn {
      border: 1px solid var(--color-accent-light);
      border-radius: 0.25rem;
      padding: 0.25rem 0.75rem;
      font-size: 0.875rem;
      color: var(--color-dark-brown);
      background: transparent;
      cursor: pointer;
    }
    .lm-btn:hover { background: var(--color-parchment-dark); }
    .lm-btn[aria-pressed='true'] { background: var(--color-parchment-dark); border-color: var(--color-accent); }
    .lm-skip {
      position: absolute;
      right: 0.75rem;
      bottom: 2.25rem;
      background: rgba(245, 240, 232, 0.92);
    }
    #ancestor-map { background: var(--color-parchment-dark); }
    .lm-tip .maplibregl-popup-content {
      background: var(--color-parchment);
      color: var(--color-ink);
      font-size: 0.8125rem;
      padding: 0.3rem 0.55rem;
      border-radius: 0.25rem;
      box-shadow: 0 1px 4px rgba(61, 46, 30, 0.25);
    }
    .lm-tip .maplibregl-popup-tip { display: none; }
    html.lm-locked, html.lm-locked body { overflow: hidden; }
    .lm-stage.lm-full {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      flex-direction: column;
      padding: 0.75rem 1rem;
      background: var(--color-parchment);
      overflow: auto;
    }
    .lm-stage.lm-full .lm-mapwrap { flex: 1 1 auto; min-height: 0; display: flex; }
    .lm-stage.lm-full #ancestor-map { height: auto; min-height: 240px; max-height: none; flex: 1 1 auto; }
    .lm-stage.lm-full .lm-legend { display: none; }
    .lm-stage.lm-full #lm-person { flex: 0 0 auto; max-height: 34vh; overflow: auto; margin-top: 0.75rem; }
    /* Wide fullscreen: the life rail docks beside the map instead of under it. */
    @media (min-width: 900px) {
      .lm-stage.lm-full {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        grid-template-rows: auto minmax(0, 1fr) auto;
        column-gap: 1rem;
      }
      .lm-stage.lm-full .lm-controls { grid-column: 1 / -1; }
      .lm-stage.lm-full .lm-mapwrap { grid-column: 1; grid-row: 2; }
      .lm-stage.lm-full .lm-branches { grid-column: 1 / -1; grid-row: 3; }
      .lm-stage.lm-full #lm-person { grid-column: 2; grid-row: 2; max-height: none; margin-top: 0; }
      .lm-stage.lm-full:has(#lm-person.hidden) .lm-mapwrap { grid-column: 1 / -1; }
    }
  </style>


  <script
    type="application/json"
    id="map-data"
    set:html={JSON.stringify({ people, branchColor, branchLabel, timeMin, timeAll: timeMaxEvent + 1 })}
  />

  <script>
    import { mountLifeMap } from '../lib/lifemap/client';

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mountLifeMap);
    else mountLifeMap();
  </script>
</BaseLayout>
